<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9" />
<title>Workstation Check &amp; Install Center</title>
<HTA:APPLICATION
    ID="wsValidator"
    APPLICATIONNAME="Workstation Check and Install Center"
    BORDER="thin"
    CAPTION="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    SCROLL="yes"
/>
<style>
* { box-sizing: border-box; }
body {
    margin: 0; padding: 0;
    background: #f3f6f9; color: #1f2937;
    font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
}
.header {
    padding: 26px 30px; background: #17365d; color: #ffffff;
}
.header h1 { margin: 0 0 8px 0; font-size: 26px; }
.header p  { margin: 4px 0; opacity: 0.95; }
.toolbar {
    padding: 16px 30px; background: #ffffff;
    border-bottom: 1px solid #ccd5e0;
}
.toolbar button {
    border: 0; border-radius: 4px; padding: 10px 18px;
    font-weight: bold; cursor: pointer; font-size: 14px;
    background: #1f4e78; color: #ffffff;
}
.toolbar button:disabled { opacity: 0.50; cursor: default; }
.toolbar .msg {
    display: inline-block; margin-left: 20px;
    font-size: 14px; color: #667085;
}
.summary {
    margin: 25px 30px; border-radius: 8px; padding: 20px;
    color: #ffffff; font-size: 22px; font-weight: bold;
    text-align: center;
}
.summary.pass    { background: #198754; }
.summary.fail    { background: #dc3545; }
.summary.neutral { background: #6c757d; }
.counts {
    display: flex; gap: 15px;
    margin: 0 30px 25px 30px;
}
.count {
    flex: 1; padding: 16px; border-radius: 8px;
    text-align: center; font-size: 18px; font-weight: bold;
}
.pass-count { background: #d1e7dd; color: #146c43; }
.fail-count { background: #f8d7da; color: #b02a37; }
.table-area { overflow-x: auto; padding: 0 30px 30px 30px; }
table {
    width: 100%; border-collapse: collapse;
    min-width: 1000px;
}
th {
    background: #1f4e78; color: white;
    text-align: left; padding: 12px; font-size: 14px;
}
td {
    border: 1px solid #ced4da; padding: 11px;
    vertical-align: top; font-size: 14px;
}
tr.pass        { background: #f1fff6; }
tr.fail        { background: #fff5f5; }
tr.installing  { background: #fff9e6; }
td.badge { font-weight: bold; white-space: nowrap; }
tr.pass       td.badge { color: #198754; }
tr.fail       td.badge { color: #dc3545; }
tr.installing td.badge { color: #9a6700; }
.row-btn button {
    border: 0; border-radius: 3px; padding: 5px 10px;
    font-size: 12px; font-weight: bold; cursor: pointer;
    background: #1f4e78; color: #ffffff;
}
.log-btn button {
    border: 0; border-radius: 3px; padding: 5px 10px;
    font-size: 12px; cursor: pointer;
    background: #e9ecef; color: #1f2937;
}
.reboot-badge {
    display: inline-block;
    background: #fff3cd; color: #856404;
    padding: 2px 8px; border-radius: 3px;
    font-size: 12px; font-weight: bold;
    margin-left: 6px;
}
.footer {
    padding: 18px 30px; background: #e9ecef;
    color: #495057; font-size: 13px;
}
</style>
</head>
<body>
<div class="header">
    <h1>Workstation Check &amp; Install Center</h1>
    <p id="machine"></p>
    <p id="timestamp"></p>
</div>
<div class="toolbar">
    <button onclick="doRescan()">RESCAN ALL</button>
    <span style="margin-left:20px; font-weight:bold;">Template:
        <select id="tplSelect" onchange="onTemplateChange()" style="padding:8px; font-size:14px;"></select>
    </span>
    <button onclick="doEditTemplate()" style="margin-left:8px;">EDIT TEMPLATE</button>
    <span id="message" class="msg">Click RESCAN ALL to begin</span>
</div>
<div id="summary" class="summary neutral">Click RESCAN ALL</div>
<div id="counts" class="counts" style="display:none;">
    <div class="count pass-count" id="passCount">PASS: 0</div>
    <div class="count fail-count" id="failCount">FAIL: 0</div>
</div>
<div class="table-area">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Application</th>
                <th>Required</th>
                <th>Installed</th>
                <th>Comment</th>
                <th>Action</th>
                <th>Log</th>
            </tr>
        </thead>
        <tbody id="rows"></tbody>
    </table>
</div>
<div class="footer">
    Local status file: <span id="statusPath"></span>
    &mdash; No data is sent to a server.
</div>

<script language="JScript">
var fso  = new ActiveXObject('Scripting.FileSystemObject');
var sh   = new ActiveXObject('WScript.Shell');
var shEx = new ActiveXObject('Shell.Application');

// ---- Determine package root from the HTA file location ----
var rawPath = unescape(document.location.pathname);
// mshta sometimes gives /C:/path/to/file.hta — strip leading slash
// when character after the slash is a drive letter colon.
if (rawPath.charAt(0) === '/' && rawPath.charAt(2) === ':') {
    rawPath = rawPath.substr(1);
}
rawPath = rawPath.replace(/\//g, '\\');
var rootDir   = fso.GetParentFolderName(rawPath);
var statusF   = rootDir + '\\Output\\status.json';
var engineDir = rootDir + '\\Engine';
var tplDir    = rootDir + '\\Templates';
var tplFile   = rootDir + '\\Output\\template.txt';

// ---- Display ----
document.getElementById('statusPath').innerText = statusF;

// ---- Helpers ----
function esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

function readJSON(filePath) {
    if (!fso.FileExists(filePath)) return null;
    try {
        var textFile = fso.OpenTextFile(filePath, 1, false, -1);
        var txt = textFile.ReadAll();
        textFile.Close();
        // JScript JSON parser inside HTA
        return eval('(' + txt + ')');
    } catch (e) {
        return null;
    }
}

function runScript(ps1file, psArgs) {
    var script = engineDir + '\\' + ps1file;
    var cmd    = '-NoProfile -ExecutionPolicy Bypass -File "' + script + '" ' + psArgs + ' -PackageRoot "' + rootDir + '"';
    try {
        // Launcher.cmd opened this HTA elevated. Using "open" preserves that
        // token and avoids a second hidden UAC request that cannot be reported
        // to the dashboard.
        shEx.ShellExecute('powershell.exe', cmd, rootDir, 'open', 0);
    } catch (e) {
        document.getElementById('message').innerText = 'Error launching script: ' + e.message;
    }
}

// ---- Templates ----
function getSavedTemplate() {
    try {
        if (!fso.FileExists(tplFile)) return '';
        var t = fso.OpenTextFile(tplFile, 1, false);
        var v = t.AtEndOfStream ? '' : t.ReadAll();
        t.Close();
        return v.replace(/^\s+|\s+$/g, '');
    } catch (e) {
        return '';
    }
}

function saveTemplate(name) {
    try {
        if (!fso.FolderExists(rootDir + '\\Output')) { fso.CreateFolder(rootDir + '\\Output'); }
        var t = fso.CreateTextFile(tplFile, true);
        t.Write(name);
        t.Close();
    } catch (e) {
        document.getElementById('message').innerText = 'Error saving template choice: ' + e.message;
    }
}

function loadTemplates() {
    var sel = document.getElementById('tplSelect');
    sel.options.length = 0;
    var first = document.createElement('option');
    first.value = '';
    first.text  = '-- All applications --';
    sel.add(first);
    if (fso.FolderExists(tplDir)) {
        var en = new Enumerator(fso.GetFolder(tplDir).Files);
        for (; !en.atEnd(); en.moveNext()) {
            var f = en.item();
            if (/\.psd1$/i.test(f.Name)) {
                var n  = f.Name.replace(/\.psd1$/i, '');
                var op = document.createElement('option');
                op.value = n;
                op.text  = n;
                sel.add(op);
            }
        }
    }
    sel.value = getSavedTemplate();
}

function onTemplateChange() {
    saveTemplate(document.getElementById('tplSelect').value);
    doRescan();
}

function doEditTemplate() {
    var n = document.getElementById('tplSelect').value;
    if (!n) {
        document.getElementById('message').innerText = 'Select a template first';
        return;
    }
    sh.Run('notepad.exe "' + tplDir + '\\' + n + '.psd1"', 1, false);
    document.getElementById('message').innerText = 'Save the template file, then click RESCAN ALL';
}

// ---- Buttons ----
function doRescan() {
    document.getElementById('message').innerText = 'Scanning...';
    runScript('Scan-All.ps1', '');
}

function doInstall(appId) {
    document.getElementById('message').innerText = 'Installing ' + appId + '...';
    runScript('Install-App.ps1', '-AppId "' + appId + '"');
}

function doLog(appId) {
    sh.Run('notepad.exe "' + rootDir + '\\Logs\\' + appId + '.log"', 1, false);
}

function clearRows() {
    var rows = document.getElementById('rows');
    while (rows.firstChild) {
        rows.removeChild(rows.firstChild);
    }
}

function appendTextCell(row, className, value) {
    var cell = document.createElement('td');
    if (className) { cell.className = className; }
    cell.innerText = value;
    row.appendChild(cell);
    return cell;
}

function appendButton(cell, label, handler) {
    var button = document.createElement('button');
    button.innerText = label;
    button.onclick = handler;
    cell.appendChild(button);
}

// ---- Render loop ----
function render() {
    var data = readJSON(statusF);

    if (!data || !data.results || data.results.length === 0) {
        document.getElementById('summary').className  = 'summary neutral';
        document.getElementById('summary').innerHTML  = 'Click RESCAN ALL';
        clearRows();
        document.getElementById('machine').innerText  = '';
        document.getElementById('timestamp').innerText = '';
        document.getElementById('counts').style.display = 'none';
        return;
    }

    document.getElementById('machine').innerText  = 'Computer: ' + esc(data.computerName) + (data.template ? '   |   Template: ' + esc(data.template) : '');
    document.getElementById('timestamp').innerText = 'Last scan: ' + esc(data.scannedAt);
    document.getElementById('counts').style.display = 'flex';

    var results = data.results;
    var passCnt = 0;
    clearRows();

    for (var i = 0; i < results.length; i++) {
        var r = results[i];

        // Read the .done file for this app (may not exist yet)
        var done = readJSON(rootDir + '\\Logs\\' + r.id + '.done');

        if (r.status === 'PASS') { passCnt++; }

        var rowClass = '';
        if (r.status === 'PASS') {
            rowClass = 'pass';
        } else if (r.status === 'INSTALLING') {
            rowClass = 'installing';
        } else {
            rowClass = 'fail';
        }

        var label = r.status;
        if (r.status === 'INSTALLING') { label = 'Installing...'; }

        var installedVer = r.installedVersion ? r.installedVersion : '\u2014';
        var requiredVer  = r.requiredVersion  ? r.requiredVersion  : 'Presence only';
        var row = document.createElement('tr');
        row.className = rowClass;

        appendTextCell(row, '', r.id);
        var statusCell = appendTextCell(row, 'badge', label);
        if (done && done.rebootRequired) {
            var rebootBadge = document.createElement('span');
            rebootBadge.className = 'reboot-badge';
            rebootBadge.innerText = 'REBOOT REQUIRED';
            statusCell.appendChild(document.createTextNode(' '));
            statusCell.appendChild(rebootBadge);
        }
        appendTextCell(row, '', r.name);
        appendTextCell(row, '', requiredVer);
        appendTextCell(row, '', installedVer);
        appendTextCell(row, '', r.comment);

        var actionCell = appendTextCell(row, 'row-btn', '');
        if (r.status === 'MISSING' || r.status === 'WRONG_VERSION') {
            appendButton(actionCell, r.status === 'MISSING' ? 'INSTALL' : 'UPGRADE', (function(appId) {
                return function() { doInstall(appId); };
            })(r.id));
        }

        var logCell = appendTextCell(row, 'log-btn', '');
        appendButton(logCell, 'View log', (function(appId) {
            return function() { doLog(appId); };
        })(r.id));
        document.getElementById('rows').appendChild(row);
    }

    var totalCnt = results.length;
    var failCnt  = totalCnt - passCnt;

    document.getElementById('passCount').innerText = 'PASS: ' + passCnt;
    document.getElementById('failCount').innerText = 'FAIL: ' + failCnt;

    var allPass = (passCnt === totalCnt && totalCnt > 0);
    document.getElementById('summary').className = 'summary ' + (allPass ? 'pass' : 'fail');
    document.getElementById('summary').innerHTML = allPass
        ? 'PASS - WORKSTATION READY'
        : 'FAIL - WORKSTATION NOT READY';

    document.getElementById('message').innerText = passCnt + ' of ' + totalCnt + ' passing';
}

// ---- Startup ----
loadTemplates();
render();
window.setInterval(render, 2000);
</script>
</body>
</html>
