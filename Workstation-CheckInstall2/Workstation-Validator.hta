<!DOCTYPE html>
<html><head><meta http-equiv="X-UA-Compatible" content="IE=9" /><title>Workstation Check &amp; Install Center</title>
<HTA:APPLICATION ID="wsValidator" APPLICATIONNAME="Workstation Check and Install Center" BORDER="thin" CAPTION="yes" SINGLEINSTANCE="yes" SYSMENU="yes" SCROLL="yes" />
<style>
body{margin:0;background:#f3f6f9;color:#1f2937;font-family:'Segoe UI',Arial}.header{padding:26px 30px;background:#17365d;color:white}.header h1{margin:0 0 8px;font-size:26px}.header p{margin:4px 0}.toolbar{padding:16px 30px;background:white;border-bottom:1px solid #ccd5e0}button{border:0;border-radius:4px;padding:8px 14px;cursor:pointer;background:#1f4e78;color:white;font-weight:bold}button:disabled{opacity:.45;cursor:default}select{padding:8px;font-size:14px}.msg{margin-left:20px;color:#667085}.summary{margin:25px 30px;padding:20px;border-radius:8px;text-align:center;font-size:22px;font-weight:bold;color:white}.pass{background:#f1fff6}.fail{background:#fff5f5}.installing{background:#fff9e6}.summary.pass{background:#198754}.summary.fail{background:#dc3545}.summary.neutral{background:#6c757d}.counts{margin:0 30px 25px}.count{padding:16px;text-align:center;font-weight:bold}.pass-count{background:#d1e7dd;color:#146c43}.fail-count{background:#f8d7da;color:#b02a37}.table-area{overflow-x:auto;padding:0 30px 30px}table{width:100%;border-collapse:collapse;min-width:1000px}th{background:#1f4e78;color:white;text-align:left;padding:12px}td{border:1px solid #ced4da;padding:11px;font-size:14px}td.badge{font-weight:bold}.log-btn button{background:#e9ecef;color:#1f2937}.reboot-badge{background:#fff3cd;color:#856404;padding:2px 8px;margin-left:6px}.footer{padding:18px 30px;background:#e9ecef}
</style></head><body>
<div class="header"><h1>Workstation Check &amp; Install Center</h1><p id="machine"></p><p id="timestamp"></p></div>
<div class="toolbar"><button id="rescan" onclick="doRescan()">RESCAN ALL</button> Template: <select id="tplSelect" onchange="onTemplateChange()"></select> <button id="editTemplate" onclick="doEditTemplate()">EDIT TEMPLATE</button> <button id="editScripts" onclick="doEditScripts()">EDIT SCRIPTS</button><span id="message" class="msg"></span></div>
<div id="summary" class="summary neutral">Click RESCAN ALL</div><div id="counts" class="counts"><div id="passCount" class="count pass-count"></div><div id="failCount" class="count fail-count"></div></div>
<div class="table-area"><h2>Applications</h2><table><thead><tr><th>ID</th><th>Status</th><th>Application</th><th>Required</th><th>Installed</th><th>Comment</th><th>Action</th><th>Log</th></tr></thead><tbody id="rows"></tbody></table></div>
<div class="table-area"><h2>Scripts</h2><p id="scriptMessage">Loading scripts...</p><table><thead><tr><th>ID</th><th>Status</th><th>Script</th><th>Path</th><th>Comment</th><th>Action</th><th>Log</th></tr></thead><tbody id="scriptRows"></tbody></table></div>
<div class="footer">Local status file: <span id="statusPath"></span> &mdash; No data is sent to a server.</div>
<script language="JScript">
var fso=new ActiveXObject('Scripting.FileSystemObject'),sh=new ActiveXObject('WScript.Shell');
var rawPath=unescape(document.location.pathname);if(rawPath.charAt(0)==='/'&&rawPath.charAt(2)===':')rawPath=rawPath.substr(1);rawPath=rawPath.replace(/\//g,'\\');
var rootDir=fso.GetParentFolderName(rawPath),statusF=rootDir+'\\Output\\status.json',tplDir=rootDir+'\\Templates',tplFile=rootDir+'\\Output\\template.txt';
var operation=null,busy=false,lastError='';
document.getElementById('statusPath').innerText=statusF;
function readJSON(path){if(!fso.FileExists(path))return null;try{var f=fso.OpenTextFile(path,1,false,-1),s=f.ReadAll();f.Close();return eval('('+s+')');}catch(e){return null;}}
function savedTemplate(){try{if(!fso.FileExists(tplFile))return '';var f=fso.OpenTextFile(tplFile,1,false),s=f.ReadAll();f.Close();return s.replace(/^\s+|\s+$/g,'');}catch(e){return '';}}
function loadTemplates(){var sel=document.getElementById('tplSelect');sel.options.length=0;var o=document.createElement('option');o.value='';o.text='-- All applications --';sel.add(o);if(fso.FolderExists(tplDir)){var en=new Enumerator(fso.GetFolder(tplDir).Files);for(;!en.atEnd();en.moveNext()){var f=en.item();if(/\.psd1$/i.test(f.Name)){o=document.createElement('option');o.value=f.Name.replace(/\.psd1$/i,'');o.text=o.value;sel.add(o);}}}sel.value=savedTemplate();if(sel.selectedIndex<0)sel.selectedIndex=0;}
function detectBusy(){if(operation){if(operation.Status===0)return true;lastError=operation.ExitCode!==0?operation.StdOut.ReadAll():' ';operation=null;}var b=readJSON(rootDir+'\\Output\\busy.json');if(b&&b.pid){try{var svc=GetObject('winmgmts:\\\\.\\root\\cimv2');var p=svc.ExecQuery('SELECT ProcessId FROM Win32_Process WHERE ProcessId='+parseInt(b.pid,10));return p.Count>0;}catch(e){return true;}}return false;}
function runTask(mode,id){if(detectBusy())return;lastError='';var args='powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+rootDir+'\\Engine\\Task-Center.ps1" -Mode '+mode+' -PackageRoot "'+rootDir+'"';if(id)args+=' -Id "'+id+'"';try{operation=sh.Exec(args);busy=true;render();}catch(e){lastError=e.message;operation=null;render();}}
function doRescan(){runTask('Scan','');}function doInstall(id){runTask('Install',id);}function doExecute(id){runTask('Script',id);}
function onTemplateChange(){if(detectBusy())return;try{var f=fso.CreateTextFile(tplFile,true);f.Write(document.getElementById('tplSelect').value);f.Close();doRescan();}catch(e){lastError=e.message;render();}}
function doEditTemplate(){if(detectBusy())return;var n=document.getElementById('tplSelect').value;if(n)sh.Run('notepad.exe "'+tplDir+'\\'+n+'.psd1"',1,false);}
function doEditScripts(){if(!detectBusy())sh.Run('notepad.exe "'+rootDir+'\\Engine\\ScriptManifest.psd1"',1,false);}
function doLog(id,script){sh.Run('notepad.exe "'+rootDir+'\\Logs\\'+(script?'script-':'')+id+'.log"',1,false);}
function cell(row,value,cls){var td=document.createElement('td');td.innerText=value==null?'':String(value);if(cls)td.className=cls;row.appendChild(td);return td;}
function button(td,label,handler,executable){var b=document.createElement('button');b.innerText=label;b.onclick=handler;b.disabled=executable&&busy;td.appendChild(b);}
function render(){busy=detectBusy();document.getElementById('rescan').disabled=busy;document.getElementById('tplSelect').disabled=busy;document.getElementById('editTemplate').disabled=busy;document.getElementById('editScripts').disabled=busy;
var data=readJSON(statusF),rows=document.getElementById('rows');rows.innerHTML='';var pass=0,total=0;
if(data&&data.results){document.getElementById('machine').innerText='Computer: '+data.computerName+(data.template?' | Template: '+data.template:'');document.getElementById('timestamp').innerText='Last scan: '+data.scannedAt;total=data.results.length;for(var i=0;i<total;i++){var r=data.results[i],tr=document.createElement('tr');tr.className=r.status==='PASS'?'pass':r.status==='INSTALLING'?'installing':'fail';if(r.status==='PASS')pass++;cell(tr,r.id);var badge=cell(tr,r.status,'badge');var done=readJSON(rootDir+'\\Logs\\'+r.id+'.done');if(done&&done.rebootRequired){var s=document.createElement('span');s.className='reboot-badge';s.innerText='REBOOT REQUIRED';badge.appendChild(s);}cell(tr,r.name);cell(tr,r.requiredVersion||'Presence only');cell(tr,r.installedVersion||'\u2014');cell(tr,r.comment);var action=cell(tr,'','row-btn');if(r.status==='MISSING'||r.status==='WRONG_VERSION')button(action,r.status==='MISSING'?'INSTALL':'UPGRADE',(function(id){return function(){doInstall(id);};})(r.id),true);button(cell(tr,'','log-btn'),'View log',(function(id){return function(){doLog(id,false);};})(r.id),false);rows.appendChild(tr);}}
var ready=total>0&&pass===total;document.getElementById('summary').className='summary '+(total?(ready?'pass':'fail'):'neutral');document.getElementById('summary').innerText=total?(ready?'PASS - WORKSTATION READY':'FAIL - WORKSTATION NOT READY'):'Click RESCAN ALL';document.getElementById('passCount').innerText='PASS: '+pass;document.getElementById('failCount').innerText='FAIL: '+(total-pass);
var scripts=readJSON(rootDir+'\\Output\\scripts.json'),sr=document.getElementById('scriptRows');sr.innerHTML='';var tasks=scripts&&scripts.results?scripts.results:[];document.getElementById('scriptMessage').innerText=tasks.length?'Script completion is tracked separately from application readiness.':'No scripts configured for this template. Use EDIT SCRIPTS, save, then RESCAN ALL.';
for(var j=0;j<tasks.length;j++){var t=tasks[j],row=document.createElement('tr');row.className=t.status==='PASS'?'pass':'fail';cell(row,t.id);cell(row,t.status,'badge');cell(row,t.name);cell(row,t.path);cell(row,t.comment);button(cell(row,'','row-btn'),'EXECUTE',(function(id){return function(){doExecute(id);};})(t.id),true);button(cell(row,'','log-btn'),'View log',(function(id){return function(){doLog(id,true);};})(t.id),false);sr.appendChild(row);}
document.getElementById('message').innerText=busy?'Operation running - execution buttons locked':lastError.replace(/^\s+|\s+$/g,'')||pass+' of '+total+' applications passing';}
loadTemplates();render();if(!busy)doRescan();window.setInterval(render,1000);
</script></body></html>
